# bitFlyer API設定 (検証・ペーパートレード時は空欄のままでOK)
BITFLYER_API_KEY=your_bitflyer_api_key_here
BITFLYER_API_SECRET=your_bitflyer_api_secret_here
ENABLE_REAL_TRADING=false

# Discord 3系統 Webhook通知URL
# 1. 定期運用・収益報告チャンネル (1時間毎の成績・大幅収益/損失速報)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
# 2. システム改善・新規戦略開発チャンネル (自律探索・ガバナンス合否・自己修復)
DISCORD_SYSTEM_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
# 3. 緊急アラート・リスク管理チャンネル (システムダウン・リソース圧迫・サーキットブレーカー)
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# 取引・リスク管理パラメータ
ANTIGRAVITY_SYMBOL=FX_BTC_JPY
ANTIGRAVITY_ORDER_SIZE=0.001
ANTIGRAVITY_MAX_DD=3000.0
